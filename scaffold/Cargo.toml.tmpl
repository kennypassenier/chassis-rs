[package]
name = "{{ name }}"
version = "0.1.0"
description = "{{ description }}"
edition = "2024"
# Pinned together with rust-toolchain.toml (standing rule 7).
rust-version = "{{ toolchain }}"
license = "MIT OR Apache-2.0"
repository = "https://github.com/{{ repo }}"
publish = false

[dependencies]
# The kit, pinned to a tag: a new kit version is a deliberate bump here,
# a build and a release (SCOPE N3). Features: drop what this service does
# not need; `passkeys` pulls OpenSSL.
chassis = { git = "{{ chassis_repo }}", tag = "{{ chassis_tag }}", version = "{{ chassis_version }}", features = ["dashboard", "passkeys", "self-update", "notify"] }
axum = { version = "0.8", default-features = false, features = ["http1", "tokio", "json", "matched-path"] }
tokio = { version = "1", features = ["rt-multi-thread", "macros", "signal"] }
serde_json = "1"

[dev-dependencies]
reqwest = { version = "0.12", default-features = false, features = ["rustls-tls", "json", "blocking", "cookies"] }
tempfile = "3"

[lints.rust]
unsafe_code = "forbid"
